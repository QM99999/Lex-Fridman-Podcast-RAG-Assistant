# Copy this file to .env and fill in the API key for the provider you use.
# Model used by script 02 (FAQ generation). Other scripts will use 03_MODEL, 04_MODEL, ...
# Provider is inferred from the model name:
#   gpt-*       -> OpenAI API (default, no DeepSeek key needed)
#   deepseek-*  -> DeepSeek API (cheaper alternative, set DEEPSEEK_API_KEY)
02_MODEL=gpt-4o-mini

# API keys
DEEPSEEK_API_KEY=sk-REPLACE_WITH_YOUR_DEEPSEEK_KEY
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_KEY

# Optional overrides (defaults live in src/02_generate_faq.py PROVIDERS):
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Retrieval configuration (03_build_index.py / 04_retrieval_eval.py) ---
# Embedding model used to vectorize chunks and queries.
03_EMBEDDING_MODEL=text-embedding-3-small
# Elasticsearch URL (used when --backend elasticsearch).
ES_URL=http://localhost:9200

# --- RAG configuration (05_rag.py / app.py / 06_rag_eval.py) ---
# Answer model used by the RAG assistant (gpt-* -> OpenAI, deepseek-* -> DeepSeek).
# gpt-5.4-mini won the 06 bake-off (83.3% vs 80.1% vs 65.9% good; deepseek was
# excluded - the FAQ ground truth was generated by it). 06 auto-updates this
# after each run.
05_MODEL=gpt-5.4-mini
# Judge model used by 06_rag_eval.py (OpenAI only, structured output; gpt-5.6
# line rejects the temperature parameter, so 06 omits it by default).
06_JUDGE_MODEL=gpt-5.6-luna
